{
  "name": "EVCS充电",
  "appid": "__UNI__EVCS_MOBILE",
  "description": "EVCS 电动汽车充电站 C端应用",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "locale": "zh-Hans",
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "EVCS充电",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F5F5",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^ev-(.*)": "@/components/ev-$1/ev-$1.vue"
    }
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#00B42A",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/station/list",
        "text": "充电站",
        "iconPath": "static/tabbar/station.png",
        "selectedIconPath": "static/tabbar/station-active.png"
      },
      {
        "pagePath": "pages/order/list",
        "text": "订单",
        "iconPath": "static/tabbar/order.png",
        "selectedIconPath": "static/tabbar/order-active.png"
      },
      {
        "pagePath": "pages/user/index",
        "text": "我的",
        "iconPath": "static/tabbar/user.png",
        "selectedIconPath": "static/tabbar/user-active.png"
      }
    ]
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "EVCS充电",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/station/list",
      "style": {
        "navigationBarTitleText": "充电站",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/station/detail",
      "style": {
        "navigationBarTitleText": "站点详情"
      }
    },
    {
      "path": "pages/station/map",
      "style": {
        "navigationBarTitleText": "附近充电站",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/charging/scan",
      "style": {
        "navigationBarTitleText": "扫码充电",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/charging/session",
      "style": {
        "navigationBarTitleText": "充电中",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/order/list",
      "style": {
        "navigationBarTitleText": "我的订单",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/order/detail",
      "style": {
        "navigationBarTitleText": "订单详情"
      }
    },
    {
      "path": "pages/user/index",
      "style": {
        "navigationBarTitleText": "个人中心"
      }
    },
    {
      "path": "pages/user/profile",
      "style": {
        "navigationBarTitleText": "个人资料"
      }
    },
    {
      "path": "pages/user/wallet",
      "style": {
        "navigationBarTitleText": "我的钱包"
      }
    },
    {
      "path": "pages/user/vehicles",
      "style": {
        "navigationBarTitleText": "我的车辆"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/phone",
      "style": {
        "navigationBarTitleText": "手机号登录"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages-sub/settings",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "设置"
          }
        },
        {
          "path": "about",
          "style": {
            "navigationBarTitleText": "关于我们"
          }
        },
        {
          "path": "help",
          "style": {
            "navigationBarTitleText": "帮助中心"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": ["pages-sub/settings"]
    }
  },
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "您的位置信息将用于查找附近充电站"
      }
    },
    "requiredPrivateInfos": ["getLocation", "chooseLocation"]
  },
  "mp-alipay": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true
  },
  "app-plus": {
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_COARSE_LOCATION\"/>",
          "<uses-permission android:name=\"android.permission.CAMERA\"/>",
          "<uses-permission android:name=\"android.permission.INTERNET\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>"
        ]
      },
      "ios": {
        "privacyDescription": {
          "NSLocationWhenInUseUsageDescription": "您的位置信息将用于查找附近充电站",
          "NSCameraUsageDescription": "用于扫描充电桩二维码"
        }
      }
    },
    "modules": {
      "Maps": {},
      "Barcode": {},
      "Payment": {}
    }
  }
}
