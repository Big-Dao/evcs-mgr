# 本地开发环境变量模板。
# 复制为 .env（已 gitignored）并填入真实值：
#   cp .env.example .ev
#
# 安全说明：
# - 这些变量仅用于本地开发。生产环境由 CI/CD 或密钥管理服务（Vault / Sealed Secrets 等）注入。
# - 禁止把真实生产密钥提交到版本库。

# ---- JWT 签名密钥（必填）----
# 至少 32 字符的随机字符串。生成方式：openssl rand -base64 32
JWT_SECRET=

# ---- 服务间调用令牌（必填）----
# evcs-auth / evcs-tenant 的 /internal/api/** 保护令牌
EVCS_INTERNAL_API_TOKEN=

# ---- Knife4j 本地开发密码（可选）----
# 访问 /doc.html 时的 basic auth 密码
KNIFE4J_PASSWORD=dev-knife4j-change-me

# ---- Grafana 本地开发密码（可选）----
# 访问 Grafana (localhost:3000) 的管理员密码
GRAFANA_ADMIN_PASSWORD=admin
